SKILLS_MANAGER_CLI=/home/user/.cargo/bin/skills-manager-cli
SKILLS_MANAGER_WEB_HOST=127.0.0.1
SKILLS_MANAGER_WEB_PORT=17321
# Required when SKILLS_MANAGER_WEB_HOST=0.0.0.0
# SKILLS_MANAGER_WEB_TOKEN=change-me
# Optional custom skills root passed to the CLI as --skills-root <path>
# SKILLS_MANAGER_SKILLS_ROOT=/home/user/.skills-manager/skills
# Optional log/job data directory
# SKILLS_MANAGER_WEB_DATA_DIR=/home/user/.local/share/skills-manager-web
